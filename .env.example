# ---------------------------------------------------------------------------
# Sourced Intel - environment configuration
#
# Copy to `.env` and fill in the values. NEVER commit the real `.env`.
# Every value here can be overridden by a real environment variable.
# ---------------------------------------------------------------------------

# --- LLM provider: "glm" (Zhipu, OpenAI-compatible) or "ollama" (local fallback)
# If GLM is unusable (bad key, no quota, no network) the pipeline falls back to
# Ollama automatically and records why - it does not crash.
LLM_PROVIDER=glm

# --- Zhipu GLM
# The key is '<key_id>.<secret>' - it MUST contain a dot. A bare 32-character hex
# string is the key id, not the key, and returns 401. Verify with:
#     python3 scripts/preflight.py
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Verified 2026-09-18 against the live /models endpoint. This account can reach:
#   glm-4.5, glm-4.5-air, glm-4.6, glm-4.7, glm-5, glm-5-turbo,
#   glm-5.1, glm-5.2, glm-5.3, glm-5.3-flash, glm-5.3-flashx
# `glm-4-flash` and `glm-4.7-flash` are NOT available. Always confirm with:
#     curl -s $GLM_BASE_URL/models -H "Authorization: Bearer $GLM_API_KEY"
GLM_MODEL=glm-4.7
# Reasoning-channel policy: "off" | "low" | "auto".
#   off  - ask the model not to think. Cheapest, and everything this pipeline does
#          is transcription or arithmetic, not reasoning. Requires a model that
#          can actually be switched off (glm-4.7, glm-4.5-air).
#   low  - for models that ALWAYS think (glm-5.x). They answer 1210 to a disable
#          request; the low setting asks for the smallest thinking budget instead.
#   auto - send nothing.
# The client downgrades off -> low on its own the first time it sees a 1210, so
# this normally needs no attention.
GLM_THINKING=off
# How many GLM requests may be in flight at once, and the minimum gap between
# them. Measured on the free tier (2026-09-25, ten calls per configuration): the
# ceiling is TWO concurrent requests. Three in flight completed only 4-5 of 10
# calls whether the spacing was 0.0 s, 0.5 s or 1.0 s; two in flight completed
# 10/10. The gap is not the tuning knob - the provider's own queueing dominates
# the wall clock (a request asking for eight tokens measured a p50 of 15-31 s).
# Exceeding the quota no longer loses data: node 3 halves a rejected batch and
# retries it instead of dropping it. It does cost extra calls, so leave these at
# the measured values unless your account has a higher quota.
GLM_MAX_CONCURRENCY=2
GLM_MIN_INTERVAL_SECONDS=0.5

# --- Ollama (offline / zero-cost fallback, used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# --- Pipeline tuning
CONFIDENCE_THRESHOLD=0.6
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
NODE_MAX_RETRIES=2
EXTRACT_BATCH_SIZE=8
EXTRACT_MAX_CONCURRENCY=4
GDELT_MIN_INTERVAL_SECONDS=6
GDELT_MAX_RECORDS=75
# GDELT is the optional breadth source. From mainland China it often fails at the
# TLS handshake rather than answering 429, so it gets its own short budget - it
# must never hold the run hostage at the global 10s timeout.
GDELT_TIMEOUT_SECONDS=4
# After a failure, skip the live attempt for this long (it is still reported as a
# failed source, just without the wait). Set to 0 to retry on every run.
GDELT_FAILURE_TTL_SECONDS=600
MAX_MAP_POINTS=200

# --- Paths
DATA_DIR=./data
